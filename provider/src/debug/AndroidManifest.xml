<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only harnesses: bootstrap probe, canary render probe, glue harness.
             Merged into debug APKs only; release/shipping APKs never contain them. -->
        <activity
            android:name="org.mozilla.geckowebview.provider.BootstrapProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="org.mozilla.geckowebview.provider.CanaryRenderActivity"
            android:exported="true" />
        <activity
            android:name="org.mozilla.geckowebview.provider.GlueHarnessActivity"
            android:exported="true" />
        <!-- Real-path acceptance (switched device only, BOOTSTRAP §2.4). -->
        <activity
            android:name="org.mozilla.geckowebview.provider.FrameworkEntryActivity"
            android:exported="true" />
        <!-- CTS triage probes (STATUS §1x); debug-only. -->
        <activity
            android:name="org.mozilla.geckowebview.provider.JsTitleProbeActivity"
            android:exported="true" />
        <!-- Background-thread multi-session burst probe (Bilibili pattern). -->
        <activity
            android:name="org.mozilla.geckowebview.provider.BurstProbeActivity"
            android:exported="true" />
        <!-- Interactive manual lab: address bar + UA override + about:
             shortcuts on the real framework path (STATUS §1aa); debug-only. -->
        <activity
            android:name="org.mozilla.geckowebview.provider.LabActivity"
            android:exported="true"
            android:label="Sinytra Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
