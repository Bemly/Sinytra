<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Sinytra Gecko WebView"
        android:allowBackup="false">

        <!-- P-1 bootstrap probe activity (not a WebView provider yet). -->
        <activity
            android:name="org.mozilla.geckowebview.provider.BootstrapProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- P0 render probe: GeckoView + session + load example.com. -->
        <activity
            android:name="org.mozilla.geckowebview.provider.P0RenderActivity"
            android:exported="true" />
        <!-- P0 glue harness: drives GeckoWebViewProvider via reflection. -->
        <activity
            android:name="org.mozilla.geckowebview.provider.P0GlueActivity"
            android:exported="true" />
    </application>
</manifest>
