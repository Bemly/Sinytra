From dc019cb6ff6a2a01c4e8b371e2806e1cfbada87a Mon Sep 17 00:00:00 2001
From: Bemly <bemly_@petalmail.com>
Date: Sun, 4 Oct 2026 19:28:05 +0800
Subject: [PATCH 3/3] Sinytra patch 0020f: force file process separation in
 host processes

---
 .../modules/geckoview/GeckoViewSettings.sys.mjs    | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/mobile/shared/modules/geckoview/GeckoViewSettings.sys.mjs b/mobile/shared/modules/geckoview/GeckoViewSettings.sys.mjs
index 87988547e340..0c5e40d28f62 100644
--- a/mobile/shared/modules/geckoview/GeckoViewSettings.sys.mjs
+++ b/mobile/shared/modules/geckoview/GeckoViewSettings.sys.mjs
@@ -97,6 +97,20 @@ export class GeckoViewSettings extends GeckoViewModule {
       } catch (e) {}
     }
 
+    // Sinytra 0020: file: documents into dedicated `file` processes.
+    // Stock Android default is off (process budget), but without it every
+    // content-triggered file: subload dies in
+    // CheckAllowLoadByTriggeringRemoteType (CONTENT_BLOCKED) — file iframes
+    // cannot function at all. Unconditional: file processes spawn on demand
+    // only (zero cost when no file: URL loads), and this runs in the host
+    // app process, so no other app is affected. Proven by the file-4 matrix.
+    try {
+      Services.prefs.setBoolPref(
+        "browser.tabs.remote.separateFileUriProcess",
+        true
+      );
+    } catch (e) {}
+
     if (settings.isExtensionPopup) {
       // NOTE: Only add the webextension-view-type and emit extension-browser-inserted
       // once, an extension popup should never change webextension-view-type once set.
-- 
2.56.0

