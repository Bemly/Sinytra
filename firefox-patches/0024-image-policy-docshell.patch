index cb2cbec48416..7f20bb3231dc 100644
--- a/mobile/shared/actors/GeckoViewSettingsChild.sys.mjs
+++ b/mobile/shared/actors/GeckoViewSettingsChild.sys.mjs
@@ -30,6 +30,60 @@ export class GeckoViewSettingsChild extends GeckoViewActorChild {
     } catch (e) {}
   }
 
+  // Sinytra 0024: re-trigger image loads in the live document after
+  // loosening, with zero navigation (see SettingsUpdate above). Images
+  // sanitized at serve time carry their source in data-sinytra-src(-set);
+  // policy-blocked images with intact sources are refetched only when
+  // visibly blank (complete + zero natural size), so healthy images are
+  // never stormed. Subframes are walked best-effort (cross-origin access
+  // throws and is skipped).
+  restoreBlockedImages() {
+    const seen = new Set();
+    const visit = doc => {
+      if (!doc || seen.has(doc)) {
+        return;
+      }
+      seen.add(doc);
+      try {
+        for (const img of doc.querySelectorAll("img")) {
+          try {
+            const backup = img.getAttribute("data-sinytra-src");
+            if (backup !== null) {
+              img.setAttribute("src", backup);
+              img.removeAttribute("data-sinytra-src");
+              const backupSet = img.getAttribute("data-sinytra-srcset");
+              if (backupSet !== null) {
+                img.setAttribute("srcset", backupSet);
+                img.removeAttribute("data-sinytra-srcset");
+              }
+              continue;
+            }
+            if (img.complete && img.naturalWidth === 0) {
+              const current = img.getAttribute("src");
+              if (current) {
+                img.setAttribute("src", "");
+                img.setAttribute("src", current);
+              }
+            }
+          } catch (e) {}
+        }
+      } catch (e) {}
+      try {
+        const frames = doc.defaultView?.frames;
+        if (frames) {
+          for (let i = 0; i < frames.length; i++) {
+            try {
+              visit(frames[i].document);
+            } catch (e) {}
+          }
+        }
+      } catch (e) {}
+    };
+    try {
+      visit(this.document);
+    } catch (e) {}
+  }
+
   observe(aSubject, aTopic) {
     if (aTopic !== "document-element-inserted") {
       return;
@@ -60,12 +114,20 @@ export class GeckoViewSettingsChild extends GeckoViewActorChild {
 
         // Sinytra 0024: cache + apply to the live docshell (covers flag
         // flips on the current document; fresh documents are covered by the
-        // document-element-inserted observer above).
+        // document-element-inserted observer above). On a loosening flip
+        // (false -> true) also restore blocked images IN PLACE: provider-
+        // initiated navigations violate the loader's exclusivity contract
+        // (the test harness fails any PageStart it did not ask for), so the
+        // live document must re-render with zero navigation.
         if (typeof settings.allowImages === "boolean") {
+          const loosened = this._allowImages === false && settings.allowImages;
           this._allowImages = settings.allowImages;
           try {
             this.docShell.allowImages = this._allowImages;
           } catch (e) {}
+          if (loosened) {
+            this.restoreBlockedImages();
+          }
         }
 
         if (settings.isExtensionPopup) {
