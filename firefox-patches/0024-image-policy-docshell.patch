From 1b882c04cbb7095a09c08df1a9c11607b57fb0e0 Mon Sep 17 00:00:00 2001
From: Bemly <bemly_@petalmail.com>
Date: Sat, 3 Oct 2026 21:05:35 +0800
Subject: [PATCH 3/7] Sinytra patch 0024c: child caches allowImages and applies
 it to own docshells

---
 .../actors/GeckoViewSettingsChild.sys.mjs     | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/mobile/shared/actors/GeckoViewSettingsChild.sys.mjs b/mobile/shared/actors/GeckoViewSettingsChild.sys.mjs
index 625905caab66..cb2cbec48416 100644
--- a/mobile/shared/actors/GeckoViewSettingsChild.sys.mjs
+++ b/mobile/shared/actors/GeckoViewSettingsChild.sys.mjs
@@ -6,6 +6,50 @@ import { GeckoViewActorChild } from "resource://gre/modules/GeckoViewActorChild.
 
 // Handles GeckoView content settings
 export class GeckoViewSettingsChild extends GeckoViewActorChild {
+  constructor() {
+    super();
+    // Sinytra 0024: per-session image policy. The docshell flag must be in
+    // place before any subresource loads (data: images load during parse),
+    // so every new document re-applies the cached session value. This also
+    // covers new tabs, which never see a SettingsUpdate without a value
+    // change (same hole as 0018's UA push).
+    this._allowImages = true;
+    // Bug 1570744: a JSWindowActorChild cannot act as nsIObserver directly,
+    // so a QI-tagged closure forwards to observe (SelectionActionDelegate
+    // precedent).
+    this._docObserver = (subject, topic) => {
+      this.observe(subject, topic);
+    };
+    this._docObserver.QueryInterface = ChromeUtils.generateQI(["nsIObserver"]);
+    Services.obs.addObserver(this._docObserver, "document-element-inserted");
+  }
+
+  didDestroy() {
+    try {
+      Services.obs.removeObserver(this._docObserver, "document-element-inserted");
+    } catch (e) {}
+  }
+
+  observe(aSubject, aTopic) {
+    if (aTopic !== "document-element-inserted") {
+      return;
+    }
+    try {
+      const docShell = aSubject.defaultView?.docShell;
+      if (!docShell) {
+        return;
+      }
+      // Own tab only (nsIDocShell exposes no browsingContext to JS, so
+      // compare docshells directly): sessions share this process-wide
+      // observer, and subframes inherit the top docshell value natively
+      // (nsDocShell) and need no explicit set.
+      if (docShell !== this.docShell) {
+        return;
+      }
+      docShell.allowImages = this._allowImages;
+    } catch (e) {}
+  }
+
   receiveMessage(message) {
     const { name } = message;
     debug`receiveMessage: ${name}`;
@@ -14,6 +58,16 @@ export class GeckoViewSettingsChild extends GeckoViewActorChild {
       case "SettingsUpdate": {
         const settings = message.data;
 
+        // Sinytra 0024: cache + apply to the live docshell (covers flag
+        // flips on the current document; fresh documents are covered by the
+        // document-element-inserted observer above).
+        if (typeof settings.allowImages === "boolean") {
+          this._allowImages = settings.allowImages;
+          try {
+            this.docShell.allowImages = this._allowImages;
+          } catch (e) {}
+        }
+
         if (settings.isExtensionPopup) {
           // Allow web extensions to close their own action popups (bz1612363)
           this.contentWindow.windowUtils.allowScriptsToClose();
-- 
