From 3d2933c15786c9ddaf3c0cc987e4c7d6f46b0e21 Mon Sep 17 00:00:00 2001
From: Bemly <bemly_@petalmail.com>
Date: Sat, 3 Oct 2026 21:05:32 +0800
Subject: [PATCH 2/7] Sinytra patch 0024b: ImageBlocker honors content docshell
 allowImages

---
 image/ImageBlocker.cpp | 42 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/image/ImageBlocker.cpp b/image/ImageBlocker.cpp
index 84dd375f1183..14604510cba1 100644
--- a/image/ImageBlocker.cpp
+++ b/image/ImageBlocker.cpp
@@ -5,7 +5,9 @@
 #include "ImageBlocker.h"
 
 #include "mozilla/StaticPrefs_permissions.h"
+#include "mozilla/dom/Document.h"
 #include "nsContentUtils.h"
+#include "nsIDocShell.h"
 #include "nsIPermissionManager.h"
 #include "nsNetUtil.h"
 
@@ -14,6 +16,39 @@ using namespace mozilla::image;
 
 NS_IMPL_ISUPPORTS(ImageBlocker, nsIContentPolicy)
 
+// Sinytra 0024: per-session docshell policy (WebView
+// loadsImagesAutomatically). Applies to every web-content scheme: data:/
+// file: image loads never consult the embedder necko hook, so this is their
+// only gate. Browser-internal schemes stay untouched.
+static bool ShouldBlockForDocShell(nsIURI* aContentLocation,
+                                   nsILoadInfo* aLoadInfo) {
+  if (!aContentLocation || !aLoadInfo) {
+    return false;
+  }
+  for (const char* scheme : {"chrome", "resource", "moz-icon"}) {
+    bool isScheme = false;
+    if (NS_SUCCEEDED(aContentLocation->SchemeIs(scheme, &isScheme)) &&
+        isScheme) {
+      return false;
+    }
+  }
+  nsCOMPtr<mozilla::dom::Document> doc;
+  if (NS_FAILED(aLoadInfo->GetLoadingDocument(getter_AddRefs(doc))) || !doc) {
+    // No loading document (e.g. parent-side navigation): fall back to the
+    // global-pref path below.
+    return false;
+  }
+  nsIDocShell* docShell = doc->GetDocShell();
+  if (!docShell) {
+    return false;
+  }
+  bool allowed = true;
+  if (NS_FAILED(docShell->GetAllowImages(&allowed)) || allowed) {
+    return false;
+  }
+  return true;
+}
+
 NS_IMETHODIMP
 ImageBlocker::ShouldLoad(nsIURI* aContentLocation, nsILoadInfo* aLoadInfo,
                          int16_t* aShouldLoad) {
@@ -30,6 +65,13 @@ ImageBlocker::ShouldLoad(nsIURI* aContentLocation, nsILoadInfo* aLoadInfo,
     return NS_OK;
   }
 
+  if (ShouldBlockForDocShell(aContentLocation, aLoadInfo)) {
+    NS_SetRequestBlockingReason(
+        aLoadInfo, nsILoadInfo::BLOCKING_REASON_CONTENT_POLICY_CONTENT_BLOCKED);
+    *aShouldLoad = nsIContentPolicy::REJECT_TYPE;
+    return NS_OK;
+  }
+
   if (ImageBlocker::ShouldBlock(aContentLocation)) {
     NS_SetRequestBlockingReason(
         aLoadInfo, nsILoadInfo::BLOCKING_REASON_CONTENT_POLICY_CONTENT_BLOCKED);
-- 
