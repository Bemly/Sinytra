From 9e7813ff56e5fe53be06320bf55ebc8c9d82026a Mon Sep 17 00:00:00 2001
From: Sinytra <sinytra@local>
Date: Mon, 12 Oct 2026 22:38:01 +0800
Subject: [PATCH] Sinytra patch 0034: LoadURI forward-branch trace (diagnostic)

BrowsingContext::LoadURI has three silent outcomes: local docshell,
null ContentParent (SendLoadURI never sent), or sent. Log which one
under the 0005 pref gate. Diagnostic - remove before final.
---
 docshell/base/BrowsingContext.cpp | 86 ++++++++++++++++++++++++++++++-
 dom/ipc/ContentChild.cpp          | 10 ++--
 2 files changed, 89 insertions(+), 7 deletions(-)

diff --git a/docshell/base/BrowsingContext.cpp b/docshell/base/BrowsingContext.cpp
index bcfcb767e8..63d7ee38b7 100644
--- a/docshell/base/BrowsingContext.cpp
+++ b/docshell/base/BrowsingContext.cpp
@@ -4,6 +4,12 @@
 
 #include "mozilla/dom/BrowsingContext.h"
 
+#ifdef MOZ_WIDGET_ANDROID
+#  include <android/log.h>
+#  include <inttypes.h>
+#  include "mozilla/Preferences.h"
+#endif
+
 #include "ipc/IPCMessageUtils.h"
 #include "mozilla/GfxMessageUtils.h"
 
@@ -2322,6 +2328,22 @@ nsresult BrowsingContext::LoadURI(nsDocShellLoadState* aLoadState,
   if (mDocShell) {
     nsCOMPtr<nsIDocShell> docShell = mDocShell;
 
+#ifdef MOZ_WIDGET_ANDROID
+    {
+      // Sinytra 0034 (companion): local-docshell branch. If this fires,
+      // the load runs parent-side and content is never involved.
+      static const bool sEnabled =
+          mozilla::Preferences::GetBool("sinytra.log.enabled", false);
+      if (sEnabled) {
+        nsAutoCString spec;
+        if (aLoadState && aLoadState->URI()) {
+          aLoadState->URI()->GetSpec(spec);
+        }
+        __android_log_print(ANDROID_LOG_DEBUG, "Sinytra/response",
+                            "BC::LoadURI local-docshell uri=%s", spec.get());
+      }
+    }
+#endif
     return docShell->LoadURI(aLoadState, aSetNavigating);
   }
 
@@ -2389,6 +2411,50 @@ nsresult BrowsingContext::LoadURI(nsDocShellLoadState* aLoadState,
       wgc->SendLoadURI(this, mozilla::WrapNotNull(aLoadState), aSetNavigating);
     }
   } else if (XRE_IsParentProcess()) {
+#ifdef MOZ_WIDGET_ANDROID
+    {
+      // Sinytra 0034: LoadURI forward-branch trace (diagnostic). Three
+      // silent outcomes live here: local docshell (parent loads directly),
+      // null ContentParent (SendLoadURI never sent — the wedged signature),
+      // or sent. Same 0005 pref gate. Diagnostic — remove before final.
+      static const bool sEnabled =
+          mozilla::Preferences::GetBool("sinytra.log.enabled", false);
+      if (sEnabled) {
+        ContentParent* probeCp = Canonical()->GetContentParent();
+        nsAutoCString spec;
+        if (aLoadState && aLoadState->URI()) {
+          aLoadState->URI()->GetSpec(spec);
+        }
+        // Sinytra 0034b: zombie-shell discriminator. A ContentParent object
+        // can outlive (or precede) its IPDL channel: alive + CanSend says
+        // the endpoint should take the message; anything else is a shell
+        // whose SendLoadURI vanishes silently (device-verified shape).
+        // Sinytra 0034c: IsInitialized + Pid separate half-opened shells
+        // (alive covers INITIALIZED) and map ChildID to an OS pid.
+        // Sinytra 0034d: log SendLoadURI's own bool result. A false here
+        // (serialization/channel failure) vs true-but-never-received
+        // (IPDL-level loss) decides the next move.
+        int64_t childId = -1;
+        int alive = 0;
+        int inited = 0;
+        int canSend = 0;
+        int32_t pid = -1;
+        if (probeCp) {
+          childId = (int64_t)probeCp->ChildID();
+          alive = (int)probeCp->IsAlive();
+          inited = (int)probeCp->IsInitialized();
+          canSend = (int)probeCp->CanSend();
+          pid = probeCp->Pid();
+        }
+        __android_log_print(
+            ANDROID_LOG_DEBUG, "Sinytra/response",
+            "BC::LoadURI uri=%s localDocShell=%d hasContentParent=%d "
+            "childId=%" PRId64 " alive=%d inited=%d canSend=%d pid=%d",
+            spec.get(), (int)(bool)mDocShell, (int)(bool)probeCp, childId,
+            alive, inited, canSend, pid);
+      }
+    }
+#endif
     if (ContentParent* cp = Canonical()->GetContentParent()) {
       // nsDocShell::LoadURI does this too, but for a process switching load
       // the entry this load adds can be committed before its notification
@@ -2452,8 +2518,24 @@ nsresult BrowsingContext::LoadURI(nsDocShellLoadState* aLoadState,
                           aLoadState->URI()->GetSpecOrDefault().get());
 #endif
 
-      (void)cp->SendLoadURI(this, mozilla::WrapNotNull(aLoadState),
-                            aSetNavigating);
+      bool loadUriSent = cp->SendLoadURI(this, mozilla::WrapNotNull(aLoadState),
+                                          aSetNavigating);
+#ifdef MOZ_WIDGET_ANDROID
+      {
+        // Sinytra 0034d (companion): SendLoadURI's own bool result. false =
+        // serialization/channel failure at send time; true-but-never-
+        // received = IPDL-level loss downstream. Same 0005 pref gate.
+        static const bool sEnabled =
+            mozilla::Preferences::GetBool("sinytra.log.enabled", false);
+        if (sEnabled) {
+          __android_log_print(ANDROID_LOG_DEBUG, "Sinytra/response",
+                              "BC::LoadURI sendDone sent=%d canSendNow=%d",
+                              (int)loadUriSent, (int)cp->CanSend());
+        }
+      }
+#else
+      (void)loadUriSent;
+#endif
     }
   } else {
     if (!sourceBC) {
diff --git a/dom/ipc/ContentChild.cpp b/dom/ipc/ContentChild.cpp
index 28592146a1..50cb90dce1 100644
--- a/dom/ipc/ContentChild.cpp
+++ b/dom/ipc/ContentChild.cpp
@@ -4347,11 +4347,11 @@ mozilla::ipc::IPCResult ContentChild::RecvLoadURI(
   {
     // Sinytra 0031b: PContent::LoadURI receipt trace (diagnostic). The two
     // silent drops below are invisible in MOZ_LOG; log arrival + which gate
-    // (if any) drops the navigation content-side. Same 0005 pref gate
-    // (Preferences.h already included). Diagnostic — remove before final.
-    static const bool sEnabled =
-        mozilla::Preferences::GetBool("sinytra.log.enabled", false);
-    if (sEnabled) {
+    // (if any) drops the navigation content-side. UNGATED on purpose: the
+    // 0005 pref itself is synced to content over the very channel under
+    // test, so gating on it would hide the failure it must reveal.
+    // Diagnostic — remove before final.
+    {
       nsAutoCString spec;
       if (aLoadState && aLoadState->URI()) {
         aLoadState->URI()->GetSpec(spec);
-- 
2.55.0

