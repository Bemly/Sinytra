diff --git a/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/CertOverrideController.java b/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/CertOverrideController.java
new file mode 100644
index 000000000000..caafbfbc682b
--- /dev/null
+++ b/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/CertOverrideController.java
@@ -0,0 +1,53 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.geckoview;
+
+import androidx.annotation.AnyThread;
+import androidx.annotation.NonNull;
+import org.mozilla.gecko.EventDispatcher;
+import org.mozilla.gecko.util.GeckoBundle;
+
+/**
+ * Sinytra patch 0006 (SSL proceed): WebView's
+ * <code>WebViewClient.onReceivedSslError</code> hands the app a
+ * <code>SslErrorHandler</code>; <code>proceed()</code> means "continue
+ * despite the invalid certificate". The navigation is already terminal on
+ * the Gecko side by then, so proceed maps to Firefox's Add-Exception flow:
+ * remember a temporary (session-scoped, per host:port+certificate) override
+ * through the nsICertOverrideService and reload the URI.
+ *
+ * <p>Why a patch: GeckoView has no certificate-override primitive at all,
+ * and the failed certificate is only reachable at error time in Gecko
+ * (docShell.failedChannel.securityInfo — captured by the LoadURIDelegate
+ * actors). See firefox-patches/0006-ssl-proceed.md.
+ */
+public final class CertOverrideController {
+    private static final String LOGTAG = "CertOverrideController";
+
+    private CertOverrideController() {}
+
+    /**
+     * Remember a temporary override for the certificate that the load of
+     * <code>uri</code> last failed with. One-shot per error: consumed on the
+     * first successful remember; a repeat failure re-captures through the
+     * error flow. Must be called after the corresponding
+     * <code>GeckoView:OnLoadError</code> (the provider wires this from
+     * SslErrorHandler.proceed()).
+     *
+     * @param uri The URI whose failed load should be allowed.
+     * @return A {@link GeckoResult} that completes with whether an override
+     *     was remembered (false when no failed certificate is stashed for
+     *     the URI).
+     */
+    @AnyThread
+    public static @NonNull GeckoResult<Boolean> allowError(
+            final @NonNull String uri) {
+        final GeckoBundle msg = new GeckoBundle(1);
+        msg.putString("uri", uri);
+
+        return EventDispatcher.getInstance()
+                .queryBoolean("GeckoView:AllowCertError", msg);
+    }
+}
diff --git a/mobile/shared/actors/LoadURIDelegateChild.sys.mjs b/mobile/shared/actors/LoadURIDelegateChild.sys.mjs
index 8a22300f297c..93c6648ee012 100644
--- a/mobile/shared/actors/LoadURIDelegateChild.sys.mjs
+++ b/mobile/shared/actors/LoadURIDelegateChild.sys.mjs
@@ -13,7 +13,7 @@ ChromeUtils.defineESModuleGetters(lazy, {
 // Implements nsILoadURIDelegate.
 export class LoadURIDelegateChild extends GeckoViewActorChild {
   // nsILoadURIDelegate.
-  handleLoadError(aUri, aError, aErrorModule) {
+  handleLoadError(aUri, aError, aErrorModule, aFailedChannel) {
     debug`handleLoadError: uri=${aUri && aUri.spec}
                              displaySpec=${aUri && aUri.displaySpec}
                              error=${aError}`;
@@ -32,6 +32,25 @@ export class LoadURIDelegateChild extends GeckoViewActorChild {
       errorClass,
     };
 
+    // Sinytra patch 0006 (SSL proceed): attach the failed server
+    // certificate for certificate errors, so the app's
+    // SslErrorHandler.proceed() can remember a temporary override.
+    // The channel is passed through the delegate contract because
+    // docShell.failedChannel only points at the error-page document's
+    // copy (set after this delegate call).
+    if (errorClass === Ci.nsINSSErrorsService.ERROR_CLASS_BAD_CERT) {
+      try {
+        const secInfo = aFailedChannel ? aFailedChannel.securityInfo : null;
+        const cert = secInfo ? secInfo.serverCert : null;
+        if (cert) {
+          const der = cert.getRawDER();
+          msg.certBase64 = btoa(String.fromCharCode.apply(null, der));
+        }
+      } catch (e) {
+        warn`certificate capture failed ${e}`;
+      }
+    }
+
     let errorPagePromise = this.sendQuery("GeckoView:OnLoadError", msg);
 
     return lazy.LoadURIDelegate.handleLoadError(
