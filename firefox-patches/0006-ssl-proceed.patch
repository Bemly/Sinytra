diff --git a/mobile/shared/modules/geckoview/GeckoViewCertOverride.sys.mjs b/mobile/shared/modules/geckoview/GeckoViewCertOverride.sys.mjs
new file mode 100644
index 000000000000..06acdb5ceda2
--- /dev/null
+++ b/mobile/shared/modules/geckoview/GeckoViewCertOverride.sys.mjs
@@ -0,0 +1,94 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of this MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Sinytra patch 0006 (SSL proceed): process-wide stash of the failed
+// certificate from GeckoView:OnLoadError plus the EventDispatcher handler
+// that turns android.webkit.SslErrorHandler.proceed() into a temporary
+// nsICertOverrideService entry (Firefox Add-Exception semantics).
+// The child actor stashes through LoadURIDelegateParent; the Java side
+// reaches allowError() via GeckoView:AllowCertError (registered in
+// GeckoViewStartup's ged list) through CertOverrideController.
+
+import { GeckoViewUtils } from "resource://gre/modules/GeckoViewUtils.sys.mjs";
+
+const { debug, warn } = GeckoViewUtils.initLogging(
+  "GeckoViewCertOverride"
+);
+
+// uri spec -> { host, port, certBase64 } captured at error time.
+const pending = new Map();
+
+function uriKey(aUriSpec) {
+  try {
+    const uri = Services.io.newURI(aUriSpec);
+    return {
+      host: uri.asciiHost,
+      // -1 is internally treated as 443 by nsICertOverrideService.
+      port: uri.port,
+    };
+  } catch (e) {
+    return null;
+  }
+}
+
+export const GeckoViewCertOverride = {
+  // Called from LoadURIDelegateParent when the child actor attached the
+  // failed server certificate to the error message.
+  stash(aUriSpec, aCertBase64) {
+    const hostPort = uriKey(aUriSpec);
+    if (!hostPort || !hostPort.host || !aCertBase64) {
+      return;
+    }
+    debug`stash cert override candidate ${aUriSpec}`;
+    pending.set(aUriSpec, {
+      host: hostPort.host,
+      port: hostPort.port,
+      certBase64: aCertBase64,
+    });
+  },
+
+  // Remember a temporary (session-scoped) override for the certificate the
+  // load of aUriSpec failed with. One-shot: consumed on first use; a repeat
+  // failure re-stashes through the error flow.
+  allowError(aUriSpec) {
+    const entry = pending.get(aUriSpec);
+    if (!entry) {
+      warn`allowError: no stashed certificate for ${aUriSpec}`;
+      return false;
+    }
+    pending.delete(aUriSpec);
+    try {
+      const certDB = Cc["@mozilla.org/security/x509certdb;1"].getService(
+        Ci.nsIX509CertDB
+      );
+      const cert = certDB.constructX509FromBase64(entry.certBase64);
+      const overrideService = Cc[
+        "@mozilla.org/security/certoverride;1"
+      ].getService(Ci.nsICertOverrideService);
+      // rememberValidityOverride asserts the main thread; ged handlers run
+      // on the gecko main thread.
+      overrideService.rememberValidityOverride(
+        entry.host,
+        entry.port,
+        {},
+        cert,
+        true
+      );
+      debug`remembered temporary override for ${entry.host}:${entry.port}`;
+      return true;
+    } catch (e) {
+      warn`allowError failed ${e}`;
+      return false;
+    }
+  },
+
+  onEvent(aEvent, aData, aCallback) {
+    switch (aEvent) {
+      case "GeckoView:AllowCertError": {
+        aCallback.onSuccess(this.allowError(aData.uri));
+        break;
+      }
+    }
+  },
+};
