@@ -4,6 +4,31 @@
 
 #include "mozilla/layers/CompositorBridgeParent.h"
 
+#ifdef MOZ_WIDGET_ANDROID
+#  include <android/log.h>
+#  include "mozilla/Preferences.h"
+
+// Sinytra firefox-patches/0028 (DIAGNOSTIC, remove before 定稿):
+// GPU-side paused-state trace. UI-side resumed=1 with zero presented
+// frames after the first blank one (device-verified 2026-10-09 MiniWV)
+// means either content never scheduled or the GPU stayed paused;
+// both Schedule* early-returns below are silent. Gated on the 0005
+// sinytra.log.enabled runtime pref.
+static bool SinytraGpuLogEnabled() {
+  static const bool sEnabled =
+      mozilla::Preferences::GetBool("sinytra.log.enabled", false);
+  return sEnabled;
+}
+
+#  define SINYTRA_GPU_LOG(...)                                          \
+    do {                                                               \
+      if (SinytraGpuLogEnabled()) {                                    \
+        __android_log_print(ANDROID_LOG_DEBUG, "Sinytra/surface",     \
+                            __VA_ARGS__);                              \
+      }                                                                \
+    } while (0)
+#endif
+
 #include <stdint.h>  // for uint64_t
 #include <stdio.h>   // for fprintf, stdout
 
@@ -582,6 +607,9 @@ bool CompositorBridgeParent::ResumeCompositionAndResize(int x, int y, int width,
 void CompositorBridgeParent::ScheduleComposition(wr::RenderReasons aReasons) {
   MOZ_ASSERT(CompositorThreadHolder::IsInCompositorThread());
   if (mPaused) {
+#ifdef MOZ_WIDGET_ANDROID
+    SINYTRA_GPU_LOG("ScheduleComposition skipPaused");
+#endif
     return;
   }
 
@@ -1573,6 +1601,9 @@ void CompositorBridgeParent::ScheduleFrameAfterSceneBuild(
     RefPtr<const wr::WebRenderPipelineInfo> aInfo) {
   MOZ_ASSERT(CompositorThreadHolder::IsInCompositorThread());
   if (mPaused) {
+#ifdef MOZ_WIDGET_ANDROID
+    SINYTRA_GPU_LOG("ScheduleFrameAfterSceneBuild skipPaused");
+#endif
     return;
   }
 
@@ -1586,6 +1617,9 @@ void CompositorBridgeParent::NotifyDidRender(const VsyncId& aCompositeStartId,
                                              TimeStamp& aRenderStart,
                                              TimeStamp& aCompositeEnd,
                                              wr::RendererStats* aStats) {
+#ifdef MOZ_WIDGET_ANDROID
+  SINYTRA_GPU_LOG("NotifyDidRender");
+#endif
   if (!mWrBridge) {
     return;
   }
diff --git a/gfx/layers/ipc/UiCompositorControllerParent.cpp b/gfx/layers/ipc/UiCompositorControllerParent.cpp
index c3f47a1eab..1a86f87d2d 100644
--- a/gfx/layers/ipc/UiCompositorControllerParent.cpp
+++ b/gfx/layers/ipc/UiCompositorControllerParent.cpp
@@ -7,6 +7,25 @@
 #  include "apz/src/APZCTreeManager.h"
 #  include "mozilla/layers/AndroidHardwareBuffer.h"
 #  include "mozilla/widget/AndroidCompositorWidget.h"
+#  include <android/log.h>
+#  include "mozilla/Preferences.h"
+
+// Sinytra firefox-patches/0028 (DIAGNOSTIC, remove before 定稿):
+// GPU-side resume-result trace (companion to the nsWindow.cpp
+// UI-side lines). Gated on the 0005 sinytra.log.enabled runtime pref.
+static bool SinytraGpuResumeLogEnabled() {
+  static const bool sEnabled =
+      mozilla::Preferences::GetBool("sinytra.log.enabled", false);
+  return sEnabled;
+}
+
+#  define SINYTRA_GPU_RESUME_LOG(...)                                  \
+    do {                                                               \
+      if (SinytraGpuResumeLogEnabled()) {                              \
+        __android_log_print(ANDROID_LOG_DEBUG, "Sinytra/surface",     \
+                            __VA_ARGS__);                              \
+      }                                                                \
+    } while (0)
 #endif
 #include <utility>
 
@@ -90,6 +109,12 @@ mozilla::ipc::IPCResult UiCompositorControllerParent::RecvResumeAndResize(
         LayoutDeviceIntSize(aWidth, aHeight));
 #endif
     *aOutResumed = parent->ResumeCompositionAndResize(aX, aY, aWidth, aHeight);
+#if defined(MOZ_WIDGET_ANDROID)
+    SINYTRA_GPU_RESUME_LOG("RecvResumeAndResize resumed=%d %dx%d",
+                           *aOutResumed, aWidth, aHeight);
+  } else {
