From faaee661957d294a8303c410aa52a2d705b005e7 Mon Sep 17 00:00:00 2001
From: Bemly <bemly_@petalmail.com>
Date: Wed, 23 Sep 2026 05:31:26 +0800
Subject: [PATCH 1/7] Sinytra patch 0001 (1/3): GeckoView session
 ResponseDelegate primitive

Java side of the response-body interception primitive, Group 1
(standalone-buildable, inert without a consumer):

- WebRequestInfo: v1 carries uri + isNavigation (method/headers land
  with the 0002 network-info plumbing).
- GeckoSession.ResponseDelegate: optional session-level delegate;
  onRequestResponse may answer a WebResponse (uri must match, body is
  the substitute content) or null to let the load proceed.
- GeckoViewResponse module handler answers the child-side
  'GeckoView:OnRequestResponse' query: invokes the delegate, drains the
  WebResponse body to base64 (Java stream objects cannot cross JVMs;
  16MB v1 cap, loud log + refuse on overflow), flattens headers to
  'name:value' pairs (GeckoBundle has no map primitive), and resolves
  {uri, statusCode, redirected, contentType, headers, bodyB64}.

No consumer yet: nothing sends the query until the C++ necko hook
(Group 3). geckoview:compileDebugJavaWithJavac green.
---
 .../org/mozilla/geckoview/GeckoSession.java   | 154 ++++++++++++++++++
 .../org/mozilla/geckoview/WebRequestInfo.java |  35 ++++
 2 files changed, 189 insertions(+)
 create mode 100644 mobile/android/geckoview/src/main/java/org/mozilla/geckoview/WebRequestInfo.java

diff --git a/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java b/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java
index e98a897205f1..65c4232c8f96 100644
--- a/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java
+++ b/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java
@@ -992,6 +992,55 @@ public class GeckoSession {
         }
       };
 
+  // Sinytra firefox-patches/0001: session-level response interception.
+  // The child necko layer queries "GeckoView:OnRequestResponse" for loads
+  // whose URI matches the registered filters; a non-null WebResponse here
+  // substitutes the channel body (nsIInterceptedChannel semantics, URL
+  // identity preserved). The body is drained to base64 because Java
+  // stream objects cannot cross the process boundary (v1 cap 16MB;
+  // streaming is 0002). Inert unless setResponseDelegate was called.
+  private final GeckoSessionHandler<ResponseDelegate> mResponseHandler =
+      new GeckoSessionHandler<ResponseDelegate>(
+          "GeckoViewResponse",
+          this,
+          new String[] {},
+          new String[] {"GeckoView:OnRequestResponse"}) {
+        @Override
+        public void handleDefaultMessage(
+            final String event, final GeckoBundle message, final EventCallback callback) {
+          callback.sendSuccess(null);
+        }
+
+        @Override
+        public void handleMessage(
+            final ResponseDelegate delegate,
+            final String event,
+            final GeckoBundle message,
+            final EventCallback callback) {
+          if (!"GeckoView:OnRequestResponse".equals(event)) {
+            super.handleDefaultMessage(event, message, callback);
+            return;
+          }
+
+          final WebRequestInfo info = WebRequestInfo.fromBundle(message);
+          final GeckoResult<WebResponse> result =
+              delegate.onRequestResponse(GeckoSession.this, info);
+          if (result == null) {
+            callback.sendSuccess(null);
+            return;
+          }
+
+          callback.resolveTo(
+              result.map(
+                  response -> {
+                    if (response == null) {
+                      return null;
+                    }
+                    return responseToBundle(response);
+                  }));
+        }
+      };
+
   private final GeckoSessionHandler<ContentDelegate> mProcessHangHandler =
       new GeckoSessionHandler<ContentDelegate>(
           "GeckoViewProcessHangMonitor", this, new String[] {"GeckoView:HangReport"}) {
@@ -1310,6 +1359,7 @@ public class GeckoSession {
         mMediaHandler,
         mNavigationHandler,
         mPermissionHandler,
+        mResponseHandler,
         mPrintHandler,
         mProcessHangHandler,
         mProgressHandler,
@@ -3559,6 +3609,86 @@ public class GeckoSession {
     return mProgressHandler.getDelegate();
   }
 
+  /**
+   * Sinytra firefox-patches/0001: session-level response interception
+   * delegate. When set, loads whose URI matches a registered filter are
+   * offered to onRequestResponse; a non-null WebResponse substitutes the
+   * response body with URL identity preserved (nsIInterceptedChannel
+   * semantics). Everything is a no-op unless setResponseDelegate was
+   * called.
+   */
+  public interface ResponseDelegate {
+    /**
+     * A resource load is starting and may be answered by the app.
+     *
+     * @param session The GeckoSession that initiated the callback.
+     * @param info Describes the load (v1: uri + isNavigation).
+     * @return A GeckoResult resolving to a WebResponse whose uri matches
+     *     info.uri and whose body supplies the substitute content, or null
+     *     to let the load proceed normally. A resolving WebResponse whose
+     *     body exceeds the 16MB v1 cap is refused with a loud log (the
+     *     load proceeds untouched).
+     */
+    @Nullable
+    GeckoResult<WebResponse> onRequestResponse(
+        @NonNull GeckoSession session, @NonNull WebRequestInfo info);
+  }
+
+  // v1 body transport cap: stream objects cannot cross the process
+  // boundary, so the body is drained to bytes and shipped base64.
+  private static final int RESPONSE_BODY_MAX_BYTES = 16 * 1024 * 1024;
+
+  @Nullable
+  private static GeckoBundle responseToBundle(final @NonNull WebResponse response) {
+    final GeckoBundle bundle = new GeckoBundle();
+    bundle.putString("uri", response.uri);
+    bundle.putInt("statusCode", response.statusCode);
+    bundle.putBoolean("redirected", response.redirected);
+    bundle.putString("contentType", response.headers.get("content-type"));
+    // GeckoBundle has no map primitive: flatten headers to "name:value"
+    // pairs; the consumer (patch 0001 C++ side) parses them back.
+    final java.util.List<String> headerPairs = new java.util.ArrayList<>();
+    for (final Map.Entry<String, String> entry : response.headers.entrySet()) {
+      headerPairs.add(entry.getKey() + ":" + entry.getValue());
+    }
+    bundle.putStringArray("headers", headerPairs.toArray(new String[0]));
+
+    final java.io.InputStream body = response.body;
+    if (body == null) {
+      bundle.putString("bodyB64", "");
+      return bundle;
+    }
+
+    final java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
+    final byte[] buffer = new byte[16384];
+    try {
+      int read;
+      while ((read = body.read(buffer)) != -1) {
+        out.write(buffer, 0, read);
+        if (out.size() > RESPONSE_BODY_MAX_BYTES) {
+          Log.w(LOGTAG, "Response body exceeds the v1 16MB cap; refusing");
+          try {
+            body.close();
+          } catch (final java.io.IOException ignored) {
+          }
+          return null;
+        }
+      }
+    } catch (final java.io.IOException e) {
+      Log.w(LOGTAG, "Failed to drain response body", e);
+      return null;
+    } finally {
+      try {
+        body.close();
+      } catch (final java.io.IOException ignored) {
+      }
+    }
+    bundle.putString(
+        "bodyB64",
+        android.util.Base64.encodeToString(out.toByteArray(), android.util.Base64.NO_WRAP));
+    return bundle;
+  }
+
   /**
    * Set the navigation callback handler. This will replace the current handler.
    *
@@ -3581,6 +3711,30 @@ public class GeckoSession {
     return mNavigationHandler.getDelegate();
   }
 
+  /**
+   * Set the response interception callback handler (Sinytra
+   * firefox-patches/0001). This will replace the current handler.
+   *
+   * @param delegate An implementation of ResponseDelegate, or null to
+   *     disable interception for this session.
+   */
+  @UiThread
+  public void setResponseDelegate(final @Nullable ResponseDelegate delegate) {
+    ThreadUtils.assertOnUiThread();
+    mResponseHandler.setDelegate(delegate, this);
+  }
+
+  /**
+   * Get the response interception callback handler.
+   *
+   * @return The current response callback handler.
+   */
+  @UiThread
+  public @Nullable ResponseDelegate getResponseDelegate() {
+    ThreadUtils.assertOnUiThread();
+    return mResponseHandler.getDelegate();
+  }
