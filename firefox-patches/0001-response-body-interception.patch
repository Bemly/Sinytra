+  if (obsService) {
+    obsService->AddObserver(new FilterPushObserver(),
+                            "sinytra-response-filters",
+                            /* ownsWeak */ false);
+    sRegistered = true;
+    __android_log_print(ANDROID_LOG_INFO, "Sinytra/response",
+                        "filter observer registered");
+  }
