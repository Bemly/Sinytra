+// one leaky singleton — controllers are per-docshell/per-load and must
+// not carry per-instance observer bookkeeping (threading + lifetime).
+struct FilterState {
+  nsTArray<nsCString> mPrefixes;
+  nsCOMPtr<nsIGeckoViewEventDispatcher> mDispatcher;
+};
+
+StaticAutoPtr<FilterState> sFilterState;
+
+class FilterPushObserver final : public nsIObserver {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIOBSERVER
+
+  FilterPushObserver() = default;
+
+ private:
+  ~FilterPushObserver() = default;
+};
+
+NS_IMPL_ISUPPORTS(FilterPushObserver, nsIObserver)
+
+NS_IMETHODIMP
+FilterPushObserver::Observe(nsISupports* aSubject, const char* aTopic,
+                            const char16_t* aData) {
+  __android_log_print(ANDROID_LOG_INFO, "Sinytra/response",
+                      "FilterPushObserver topic=%s", aTopic);
+  if (strcmp(aTopic, "sinytra-response-filters") != 0) {
+    return NS_OK;
+  }
+  nsCOMPtr<nsIGeckoViewEventDispatcher> dispatcher =
+      do_QueryInterface(aSubject);
+  NS_ENSURE_TRUE(dispatcher, NS_OK);
+
+  nsTArray<nsCString> prefixes;
+  if (aData) {
+    nsAutoCString joined = NS_ConvertUTF16toUTF8(nsDependentString(aData));
+    uint32_t start = 0;
+    for (uint32_t i = 0; i <= joined.Length(); ++i) {
+      if (i == joined.Length() || joined[i] == '\n') {
+        if (i > start) {
+          prefixes.AppendElement(Substring(joined, start, i - start));
+        }
+        start = i + 1;
+      }
+    }
+  }
+
+  if (!sFilterState) {
+    sFilterState = new FilterState();
+  }
+  sFilterState->mPrefixes = std::move(prefixes);
+  sFilterState->mDispatcher = std::move(dispatcher);
+  __android_log_print(ANDROID_LOG_INFO, "Sinytra/response",
+                      "filters pushed: %zu", (size_t)sFilterState->mPrefixes.Length());
+  return NS_OK;
+}
+
+// Registers the push observer; safe to call repeatedly, main thread only.
+void EnsureFilterObserver() {
+  MOZ_ASSERT(NS_IsMainThread());
+  static bool sRegistered = false;
+  if (sRegistered) {
+    return;
+  }
