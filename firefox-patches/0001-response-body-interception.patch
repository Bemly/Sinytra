@@ -0,0 +1,35 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.geckoview;
+
+import androidx.annotation.NonNull;
+import org.mozilla.gecko.util.GeckoBundle;
+
+/**
+ * Describes a resource load presented to {@link GeckoSession.ResponseDelegate}.
+ *
+ * Sinytra firefox-patches/0001: v1 carries uri + isNavigation only; method
+ * and request headers arrive with 0002 (network-level info plumbing).
+ */
+public final class WebRequestInfo {
+  /** The URI being loaded. */
+  public final @NonNull String uri;
+
+  /**
+   * True when the load is a top-level or subframe navigation (docshell);
+   * false for subresource loads (images, CSS, fetch/XHR, ...).
+   */
+  public final boolean isNavigation;
+
+  /* package */ WebRequestInfo(final @NonNull String uri, final boolean isNavigation) {
+    this.uri = uri;
+    this.isNavigation = isNavigation;
+  }
+
+  /* package */ static WebRequestInfo fromBundle(final GeckoBundle message) {
+    return new WebRequestInfo(
+        message.getString("uri", ""), message.getBoolean("isNavigation", false));
+  }
+}
