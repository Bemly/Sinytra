                             /* ownsWeak */ false);
     sRegistered = true;
     __android_log_print(ANDROID_LOG_INFO, "Sinytra/response",
-                        "filter observer registered");
+                        "filter observer registered parent=%d",
+                        static_cast<int>(XRE_IsParentProcess()));
   }
 }
 
diff --git a/mobile/shared/modules/geckoview/GeckoViewNavigation.sys.mjs b/mobile/shared/modules/geckoview/GeckoViewNavigation.sys.mjs
index 7add099a3791..3bd2ec6def83 100644
--- a/mobile/shared/modules/geckoview/GeckoViewNavigation.sys.mjs
+++ b/mobile/shared/modules/geckoview/GeckoViewNavigation.sys.mjs
@@ -164,11 +164,31 @@ export class GeckoViewNavigation extends GeckoViewModule {
