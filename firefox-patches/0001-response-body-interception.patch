From 49e23b4bcc0549072820ea254973443162b1e033 Mon Sep 17 00:00:00 2001
From: Bemly <bemly_@petalmail.com>
Date: Thu, 24 Sep 2026 00:38:09 +0800
Subject: [PATCH 6/7] Sinytra patch 0001: mark response bundle handled +
 case-insensitive content-type
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Second blocker, found on device: ResponseCallback::OnSuccess gates on
handled===true before reading statusCode/bodyB64, but responseToBundle
never set the key — every synthesized answer was discarded with
ResetInterception, the channel fell back to the network (body.example
is NXDOMAIN) and died with GeckoView:OnLoadError 185ms after PageStart.
The page never existed, so the JS transport never ran and the probe's
evals all timed out.

- responseToBundle: set handled=true (a bundle is only produced when
  the delegate returned a WebResponse; the null/not-handled path
  completes the callback with null, which OnSuccess already treats as
  reset).
- content-type: scan headers case-insensitively instead of
  headers.get('content-type') — embedders set 'Content-Type'.

After this: onPageFinished returns (185ms), the eval reads
sinytra-body-0001, URL identity asserted; full harness 29 PASS.

Debug aid (downgrade before finalizing): Log.i on the filter push
dispatch.
---
 .../org/mozilla/geckoview/GeckoSession.java    | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java b/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java
index 2141bf83fbd2..83ff36615724 100644
--- a/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java
+++ b/mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java
@@ -3650,10 +3650,23 @@ public class GeckoSession {
   @Nullable
   private static GeckoBundle responseToBundle(final @NonNull WebResponse response) {
     final GeckoBundle bundle = new GeckoBundle();
+    // The C++ consumer (patch 0001 OnSuccess) gates on handled===true
+    // before reading statusCode/bodyB64; without it the answer is
+    // discarded and the channel falls back to the network.
+    bundle.putBoolean("handled", true);
     bundle.putString("uri", response.uri);
     bundle.putInt("statusCode", response.statusCode);
     bundle.putBoolean("redirected", response.redirected);
-    bundle.putString("contentType", response.headers.get("content-type"));
+    // Header names are not case-normalized end to end (embedders may set
+    // "Content-Type"), so scan instead of a case-sensitive map get.
+    String contentType = null;
+    for (final Map.Entry<String, String> entry : response.headers.entrySet()) {
+      if ("content-type".equalsIgnoreCase(entry.getKey())) {
+        contentType = entry.getValue();
+        break;
+      }
+    }
+    bundle.putString("contentType", contentType);
     // GeckoBundle has no map primitive: flatten headers to "name:value"
     // pairs; the consumer (patch 0001 C++ side) parses them back.
     final java.util.List<String> headerPairs = new java.util.ArrayList<>();
@@ -3736,6 +3749,9 @@ public class GeckoSession {
       // controller (nsIObserver hop via the parent navigation module).
       final GeckoBundle message = new GeckoBundle();
       message.putStringArray("filters", delegate.getUriFilters());
+      Log.i("Sinytra/response",
+            "dispatching GeckoView:ResponseFilters filters="
+                + java.util.Arrays.toString(delegate.getUriFilters()));
       getEventDispatcher().dispatch("GeckoView:ResponseFilters", message);
     }
   }
-- 
