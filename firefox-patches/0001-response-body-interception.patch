     GeckoResult<WebResponse> onRequestResponse(
         @NonNull GeckoSession session, @NonNull WebRequestInfo info);
+
+    /**
+     * URI prefixes (http/https spec prefixes) the delegate can answer.
+     * Pushed to the Gecko-side interception controller when the delegate
+     * is set; loads matching none of them never cross the process
+     * boundary. Return an empty array to keep interception disabled.
+     */
+    @NonNull
+    String[] getUriFilters();
   }
 
   // v1 body transport cap: stream objects cannot cross the process
@@ -3722,6 +3731,13 @@ public class GeckoSession {
   public void setResponseDelegate(final @Nullable ResponseDelegate delegate) {
     ThreadUtils.assertOnUiThread();
     mResponseHandler.setDelegate(delegate, this);
+    if (delegate != null) {
+      // Sinytra 0001: push the filters to the Gecko-side interception
+      // controller (nsIObserver hop via the parent navigation module).
+      final GeckoBundle message = new GeckoBundle();
+      message.putStringArray("filters", delegate.getUriFilters());
+      getEventDispatcher().dispatch("GeckoView:ResponseFilters", message);
+    }
   }
 
   /**
