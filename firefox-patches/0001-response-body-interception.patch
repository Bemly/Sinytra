diff --git a/mobile/android/components/geckoview/GeckoViewResponseController.cpp b/mobile/android/components/geckoview/GeckoViewResponseController.cpp
new file mode 100644
index 000000000000..5662c8efd6cc
--- /dev/null
+++ b/mobile/android/components/geckoview/GeckoViewResponseController.cpp
@@ -0,0 +1,316 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "GeckoViewResponseController.h"
+
+#include "js/CharacterEncoding.h"
+#include "js/Conversions.h"
+#include "js/ForOfIterator.h"
+#include "jsapi.h"
+#include "mozilla/Base64.h"
+#include "mozilla/StaticPtr.h"
+#include "mozilla/dom/ScriptSettings.h"
+#include "nsIGeckoViewBridge.h"
+#include "nsNetUtil.h"
+#include "mozilla/dom/ServiceWorkerInterceptController.h"
+#include "xpcpublic.h"
+
+using namespace mozilla;
+
+namespace {
+
+StaticRefPtr<GeckoViewResponseController> sController;
+
+nsAutoCString ValueToAscii(JSContext* aCx, JS::Handle<JS::Value> aValue) {
+  nsAutoCString out;
+  JS::Rooted<JSString*> str(aCx, JS::ToString(aCx, aValue));
+  if (!str) {
+    return out;
+  }
+  JS::UniqueChars utf8(JS_EncodeStringToUTF8(aCx, str));
+  if (utf8) {
+    out.Assign(utf8.get(), strlen(utf8.get()));
+  }
+  return out;
+}
+
+class BodyCompleteCallback final : public nsIInterceptedBodyCallback {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIINTERCEPTEDBODYCALLBACK
+
+  BodyCompleteCallback() = default;
+
+ private:
+  ~BodyCompleteCallback() = default;
+};
+
+NS_IMPL_ISUPPORTS(BodyCompleteCallback, nsIInterceptedBodyCallback)
+
+NS_IMETHODIMP
+BodyCompleteCallback::BodyComplete(nsresult aRv) { return NS_OK; }
+
+// Receives the "GeckoView:OnRequestResponse" reply from the app (a JS value
+// unboxed from the Java GeckoBundle) and synthesizes the response.
+class ResponseCallback final : public nsIGeckoViewEventCallback {
+ public:
+  NS_DECL_ISUPPORTS
+
+  explicit ResponseCallback(nsCOMPtr<nsIInterceptedChannel> aChannel)
+      : mChannel(std::move(aChannel)) {}
+
+  NS_IMETHOD
+  OnSuccess(JS::Handle<JS::Value> aData, JSContext* aCx_) override {
+    (void)aCx_;
+    nsAutoCString bodyB64, contentType;
+    uint32_t statusCode = 200;
+    nsTArray<nsCString> headerPairs;
+
+    dom::AutoJSAPI jsapi;
+    if (NS_WARN_IF(!jsapi.Init(xpc::PrivilegedJunkScope()))) {
+      mChannel->ResetInterception(false);
+      return NS_OK;
+    }
+    JSContext* cx = jsapi.cx();
+    JS::Rooted<JS::Value> data(cx, aData);
+
+    if (!data.isObject()) {
+      mChannel->ResetInterception(false);
+      return NS_OK;
+    }
+    JS::Rooted<JSObject*> obj(cx, &data.toObject());
+
+    JS::Rooted<JS::Value> value(cx);
+    bool handled = false;
+    if (!JS_GetProperty(cx, obj, "handled", &value) || !value.isBoolean() ||
+        !(handled = value.toBoolean()) || !handled) {
+      mChannel->ResetInterception(false);
+      return NS_OK;
+    }
+
+    if (!JS_GetProperty(cx, obj, "statusCode", &value) ||
+        !JS::ToUint32(cx, value, &statusCode)) {
+      mChannel->ResetInterception(false);
+      return NS_OK;
+    }
+
+    if (!JS_GetProperty(cx, obj, "bodyB64", &value)) {
+      mChannel->ResetInterception(false);
+      return NS_OK;
+    }
+    bodyB64 = ValueToAscii(cx, value);
+    if (bodyB64.IsEmpty()) {
+      mChannel->ResetInterception(false);
+      return NS_OK;
+    }
+
+    if (JS_GetProperty(cx, obj, "contentType", &value) &&
+        !value.isNullOrUndefined()) {
+      contentType = ValueToAscii(cx, value);
+    }
+
+    JS::Rooted<JS::Value> headers(cx);
+    if (JS_GetProperty(cx, obj, "headers", &headers) && headers.isObject()) {
+      JS::ForOfIterator it(cx);
+      if (it.init(headers,
+                  JS::ForOfIterator::NonIterableBehavior::ThrowOnNonIterable)) {
+        JS::Rooted<JS::Value> entry(cx);
+        bool done = false;
+        while (!done && it.next(&entry, &done)) {
+          nsAutoCString pair = ValueToAscii(cx, entry);
+          int32_t sep = pair.FindChar(':');
+          if (sep > 0) {
+            headerPairs.AppendElement(pair);
+          }
+        }
+      }
+    }
+
+    Synthesize(bodyB64, contentType, statusCode, headerPairs);
+    return NS_OK;
+  }
+
+  NS_IMETHOD
+  OnError(JS::Handle<JS::Value> aData, JSContext* aCx_) override {
+    (void)aCx_;
+    // App failure: fall through to the network untouched.
+    mChannel->ResetInterception(false);
+    return NS_OK;
+  }
+
+ private:
+  ~ResponseCallback() = default;
+
+  void Synthesize(const nsAutoCString& aBodyB64,
+                  const nsAutoCString& aContentType, uint32_t aStatusCode,
+                  const nsTArray<nsCString>& aHeaderPairs) {
+    nsAutoCString decoded;
+    if (NS_FAILED(Base64Decode(aBodyB64, decoded))) {
+      mChannel->ResetInterception(false);
+      return;
+    }
+
+    nsCOMPtr<nsIInputStream> body;
+    NS_NewCStringInputStream(getter_AddRefs(body), decoded);
+
+    if (!aContentType.IsEmpty()) {
+      mChannel->SynthesizeHeader("Content-Type"_ns, aContentType);
+    }
+    for (const nsCString& pair : aHeaderPairs) {
+      int32_t sep = pair.FindChar(':');
+      if (sep > 0) {
+        mChannel->SynthesizeHeader(Substring(pair, 0, sep),
+                                   Substring(pair, sep + 1));
+      }
+    }
+    mChannel->SynthesizeStatus((uint16_t)aStatusCode, "OK"_ns);
+
+    nsCOMPtr<nsIChannel> channel;
+    mChannel->GetChannel(getter_AddRefs(channel));
+    nsAutoCString spec;
+    if (channel) {
+      nsCOMPtr<nsIURI> uri;
+      channel->GetURI(getter_AddRefs(uri));
+      if (uri) {
+        uri->GetSpec(spec);
+      }
+    }
+
+    nsresult rv = mChannel->StartSynthesizedResponse(
+        body, new BodyCompleteCallback(), nullptr, spec, false);
+    if (NS_FAILED(rv)) {
+      mChannel->CancelInterception(NS_ERROR_INTERCEPTION_FAILED);
+      return;
+    }
+    mChannel->FinishSynthesizedResponse();
+  }
+
+  nsCOMPtr<nsIInterceptedChannel> mChannel;
+};
+
+NS_IMPL_ISUPPORTS(ResponseCallback, nsIGeckoViewEventCallback)
+
+}  // namespace
+
+GeckoViewResponseController::GeckoViewResponseController(
+    RefPtr<mozilla::dom::ServiceWorkerInterceptController> aSWController)
+    : mSWController(std::move(aSWController)) {}
+
+NS_IMPL_ISUPPORTS(GeckoViewResponseController, nsINetworkInterceptController)
+
+already_AddRefed<GeckoViewResponseController>
+GeckoViewResponseController::GetSingleton() {
+  if (!sController) {
+    sController = new GeckoViewResponseController();
+    ClearOnShutdown(&sController);
+  }
+  return do_AddRef(sController);
+}
+
+void GeckoViewResponseController::SetFilters(
+    const nsTArray<nsCString>& aPrefixes,
+    nsIGeckoViewEventDispatcher* aDispatcher) {
+  MOZ_ASSERT(NS_IsMainThread());
+  GetSingleton();
+  sController->mPrefixes = aPrefixes.Clone();
+  sController->mDispatcher = aDispatcher;
+}
+
+bool GeckoViewResponseController::MatchesFilter(nsIURI* aURI) {
+  if (mPrefixes.IsEmpty()) {
+    return false;
+  }
+  bool isHttp = false, isHttps = false;
+  if (NS_FAILED(aURI->SchemeIs("http", &isHttp)) ||
+      NS_FAILED(aURI->SchemeIs("https", &isHttps)) || (!isHttp && !isHttps)) {
+    return false;
+  }
+  nsAutoCString spec;
+  if (NS_FAILED(aURI->GetSpec(spec))) {
+    return false;
+  }
+  for (const nsCString& prefix : mPrefixes) {
+    if (StringBeginsWith(spec, prefix)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+NS_IMETHODIMP
+GeckoViewResponseController::ShouldPrepareForIntercept(
+    nsIURI* aURI, nsIChannel* aChannel, bool* aShouldIntercept) {
+  MOZ_ASSERT(NS_IsMainThread());
+  *aShouldIntercept = false;
+
+  if (MatchesFilter(aURI)) {
+    *aShouldIntercept = true;
+    return NS_OK;
+  }
+
+  if (mSWController) {
+    return mSWController->ShouldPrepareForIntercept(aURI, aChannel,
+                                                    aShouldIntercept);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+GeckoViewResponseController::ChannelIntercepted(
+    nsIInterceptedChannel* aChannel) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  nsCOMPtr<nsIChannel> intercepted;
+  aChannel->GetChannel(getter_AddRefs(intercepted));
+  nsCOMPtr<nsIURI> uri;
+  if (intercepted) {
+    intercepted->GetURI(getter_AddRefs(uri));
+  }
+  if (!mDispatcher || !uri || !MatchesFilter(uri)) {
+    if (mSWController) {
+      return mSWController->ChannelIntercepted(aChannel);
+    }
+    aChannel->ResetInterception(false);
+    return NS_OK;
+  }
+
+  nsAutoCString spec;
+  uri->GetSpec(spec);
+
+  dom::AutoJSAPI jsapi;
+  if (NS_WARN_IF(!jsapi.Init(xpc::PrivilegedJunkScope()))) {
+    aChannel->ResetInterception(false);
+    return NS_OK;
+  }
+  JSContext* cx = jsapi.cx();
+  JS::Rooted<JSObject*> data(cx, JS_NewPlainObject(cx));
+  if (!data) {
+    aChannel->ResetInterception(false);
+    return NS_OK;
+  }
+  JS::Rooted<JS::Value> uriValue(
+      cx, JS::StringValue(JS_NewStringCopyZ(cx, spec.get())));
+  if (!uriValue.isString()) {
+    aChannel->ResetInterception(false);
+    return NS_OK;
+  }
+  JS_SetProperty(cx, data, "uri", uriValue);
+  JS_SetProperty(cx, data, "isNavigation", JS::TrueHandleValue);
+  JS::Rooted<JS::Value> dataValue(cx, JS::ObjectValue(*data));
+
+  JS::Rooted<JS::Value> eventValue(
+      cx, JS::StringValue(
+              JS_NewStringCopyZ(cx, "GeckoView:OnRequestResponse")));
+  if (!eventValue.isString()) {
+    aChannel->ResetInterception(false);
+    return NS_OK;
+  }
+  RefPtr<ResponseCallback> callback = new ResponseCallback(aChannel);
+  nsresult rv = mDispatcher->Dispatch(eventValue, dataValue, callback,
+                                      nullptr, cx);
+  if (NS_FAILED(rv)) {
+    aChannel->ResetInterception(false);
+  }
+  return NS_OK;
+}
