@@ -0,0 +1,49 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of this file was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.geckoview;
+
+import androidx.annotation.AnyThread;
+import androidx.annotation.NonNull;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+import org.mozilla.gecko.annotation.WrapForJNI;
+
+/**
+ * Process-level registry handing app-provided response streams to native
+ * code (Sinytra firefox-patches/0003).
+ *
+ * <p>The interception query runs entirely in the app process (the parent-side
+ * real nsHttpChannel — 0002 design doc §3), so the body crosses a JNI
+ * boundary, not a process one: the Java query handler wraps the app
+ * InputStream in a {@link GeckoViewInputStream}, registers it here and ships
+ * the id in the response bundle; native takes it back by id and reads
+ * incrementally — no base64, no size cap.
+ */
+@WrapForJNI
+@AnyThread
+/* package */ final class GeckoViewResponseStreams {
+  private static final Map<Long, GeckoViewInputStream> sStreams =
+      new ConcurrentHashMap<>();
+  private static final AtomicLong sNextId = new AtomicLong(1);
+
+  private GeckoViewResponseStreams() {}
+
+  /* package */ static long register(final @NonNull GeckoViewInputStream stream) {
+    final long id = sNextId.getAndIncrement();
+    sStreams.put(id, stream);
+    return id;
+  }
+
+  /**
+   * Called by native code to take (and unregister) the stream for a response
+   * body id. Returns null when the id is unknown (e.g. the delegate produced
+   * no body, or the query was answered twice).
+   */
+  @WrapForJNI
+  /* package */ static GeckoViewInputStream take(final long id) {
+    return sStreams.remove(id);
+  }
+}
