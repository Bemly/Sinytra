From 6b755e696792609ece430455f24a76dc35c51a8a Mon Sep 17 00:00:00 2001
From: Bemly <bemly_@petalmail.com>
Date: Wed, 30 Sep 2026 16:08:52 +0800
Subject: [PATCH] Sinytra patch 0011: scope GetCookie to exact host+path

---
 .../GeckoViewStorageController.sys.mjs        | 51 +++++++++++++++++--
 1 file changed, 47 insertions(+), 4 deletions(-)

diff --git a/mobile/shared/modules/geckoview/GeckoViewStorageController.sys.mjs b/mobile/shared/modules/geckoview/GeckoViewStorageController.sys.mjs
index be1c525c716d..90ed1c061cac 100644
--- a/mobile/shared/modules/geckoview/GeckoViewStorageController.sys.mjs
+++ b/mobile/shared/modules/geckoview/GeckoViewStorageController.sys.mjs
@@ -294,6 +294,9 @@ export const GeckoViewStorageController = {
 
   // Sinytra: Cookie header string for the URI, ordered per RFC 6265
   // (aSorted). Native-level read: HttpOnly included, Secure only for https.
+  // Matches CookieService::GetCookiesForURI filtering (domain + path +
+  // secure + expiry); getCookiesFromHost alone is base-domain-wide and
+  // would leak sibling-subdomain cookies.
   getCookieString(aUriSpec) {
     let uri;
     try {
@@ -306,10 +309,48 @@ export const GeckoViewStorageController = {
       // file:// and friends have no cookie jar.
       return "";
     }
-    const secureOnly = uri.schemeIs("https");
+    const path = uri.pathQueryRef || "/";
+    const secureOrigin = uri.schemeIs("https");
+    const nowMs = Date.now();
+    // Host cookies match only their exact host; domain cookies (leading
+    // dot) match the cookie domain and its subdomains.
+    const hostMatches = (cookieHost, reqHost) => {
+      if (!cookieHost) {
+        return false;
+      }
+      if (cookieHost.startsWith(".")) {
+        const domain = cookieHost.slice(1).toLowerCase();
+        const lower = reqHost.toLowerCase();
+        return lower === domain || lower.endsWith("." + domain);
+      }
+      return cookieHost.toLowerCase() === reqHost.toLowerCase();
+    };
+    // RFC 6265 §5.1.4 path-match: identical, or cookie-path is a prefix
+    // ending in "/", or the next request-path char after the prefix is "/".
+    const pathMatches = (cookiePath, reqPath) => {
+      const cp = cookiePath || "/";
+      if (reqPath === cp) {
+        return true;
+      }
+      if (reqPath.startsWith(cp)) {
+        if (cp.endsWith("/")) {
+          return true;
+        }
+        if (reqPath.length > cp.length && reqPath[cp.length] === "/") {
+          return true;
+        }
+      }
+      return false;
+    };
     const cookies = Services.cookies.getCookiesFromHost(host, {}, true);
     return cookies
-      .filter(c => secureOnly || !c.isSecure)
+      .filter(
+        c =>
+          hostMatches(c.host, host) &&
+          pathMatches(c.path, path) &&
+          (secureOrigin || !c.isSecure) &&
+          (c.isSession || !c.expiry || c.expiry > nowMs)
+      )
       .map(c => `${c.name}=${c.value}`)
       .join("; ");
   },
@@ -322,6 +363,8 @@ export const GeckoViewStorageController = {
   // Chromium.
   setCookie(aUriSpec, aCookieString) {
     // Mirror Chromium: setting fails while cookies are globally rejected.
+    // (The provider pushes the behavior synchronously before every jar
+    // query, so reading the live pref here is race-free.)
     if (
       Services.cookies.getCookieBehavior(false) ===
       Ci.nsICookieService.BEHAVIOR_REJECT
@@ -433,10 +476,10 @@ export const GeckoViewStorageController = {
           ? Ci.nsICookie.SCHEME_HTTPS
           : Ci.nsICookie.SCHEME_HTTP
       );
-      return validation.result === Ci.nsICookieValidation.eOK;
+      return validation != null &&
+        validation.result === Ci.nsICookieValidation.eOK;
     } catch (e) {
       // e.g. single-label domain cookies, which add() refuses.
-      warn`setCookie failed ${e}`;
       return false;
     }
   },
