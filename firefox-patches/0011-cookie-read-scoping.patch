From a61c422a0ef95c631ab9752a90905519b2794d21 Mon Sep 17 00:00:00 2001
From: Bemly <bemly_@petalmail.com>
Date: Thu, 1 Oct 2026 12:58:21 +0800
Subject: [PATCH 1/2] Sinytra patch 0011: scope GetCookie to exact host+path
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Filter getCookieString by host (exact vs leading-dot domain),
  RFC 6265 path, secure and expiry (ms units per nsICookie.idl),
  mirroring CookieService::GetCookiesForURI; getCookiesFromHost
  alone is base-domain-wide and leaks sibling-subdomain cookies.
- RFC 6265 5.3 default cookie-path from the request URI (not a
  hardcoded slash): same-name cookies must replace, not duplicate.
  (The helper is an object method — call as this.defaultCookiePath;
  a bare call throws ReferenceError and the query never answers.)
- Null-guard the add() validation result.
- Programmatic sets ignore the cookieBehavior gate: Chromium lets
  explicit CookieManager.setCookie writes through regardless of
  setAcceptCookie (the flag only governs network/page cookies).
- Reject SameSite=None without Secure (RFC 6265bis/Chromium).
---
 .../GeckoViewStorageController.sys.mjs        | 99 ++++++++++++++++---
 1 file changed, 87 insertions(+), 12 deletions(-)

diff --git a/mobile/shared/modules/geckoview/GeckoViewStorageController.sys.mjs b/mobile/shared/modules/geckoview/GeckoViewStorageController.sys.mjs
index be1c525c716d..125574c2b32a 100644
--- a/mobile/shared/modules/geckoview/GeckoViewStorageController.sys.mjs
+++ b/mobile/shared/modules/geckoview/GeckoViewStorageController.sys.mjs
@@ -294,6 +294,9 @@ export const GeckoViewStorageController = {
 
   // Sinytra: Cookie header string for the URI, ordered per RFC 6265
   // (aSorted). Native-level read: HttpOnly included, Secure only for https.
+  // Matches CookieService::GetCookiesForURI filtering (domain + path +
+  // secure + expiry); getCookiesFromHost alone is base-domain-wide and
+  // would leak sibling-subdomain cookies.
   getCookieString(aUriSpec) {
     let uri;
     try {
@@ -306,14 +309,74 @@ export const GeckoViewStorageController = {
       // file:// and friends have no cookie jar.
       return "";
     }
-    const secureOnly = uri.schemeIs("https");
+    const path = uri.pathQueryRef || "/";
+    const secureOrigin = uri.schemeIs("https");
+    const nowMs = Date.now();
+    // Host cookies match only their exact host; domain cookies (leading
+    // dot) match the cookie domain and its subdomains.
+    const hostMatches = (cookieHost, reqHost) => {
+      if (!cookieHost) {
+        return false;
+      }
+      if (cookieHost.startsWith(".")) {
+        const domain = cookieHost.slice(1).toLowerCase();
+        const lower = reqHost.toLowerCase();
+        return lower === domain || lower.endsWith("." + domain);
+      }
+      return cookieHost.toLowerCase() === reqHost.toLowerCase();
+    };
+    // RFC 6265 §5.1.4 path-match: identical, or cookie-path is a prefix
+    // ending in "/", or the next request-path char after the prefix is "/".
+    const pathMatches = (cookiePath, reqPath) => {
+      const cp = cookiePath || "/";
+      if (reqPath === cp) {
+        return true;
+      }
+      if (reqPath.startsWith(cp)) {
+        if (cp.endsWith("/")) {
+          return true;
+        }
+        if (reqPath.length > cp.length && reqPath[cp.length] === "/") {
+          return true;
+        }
+      }
+      return false;
+    };
     const cookies = Services.cookies.getCookiesFromHost(host, {}, true);
     return cookies
-      .filter(c => secureOnly || !c.isSecure)
+      .filter(
+        c =>
+          hostMatches(c.host, host) &&
+          pathMatches(c.path, path) &&
+          (secureOrigin || !c.isSecure) &&
+          (c.isSession || !c.expiry || c.expiry > nowMs)
+      )
       .map(c => `${c.name}=${c.value}`)
       .join("; ");
   },
 
+  // RFC 6265 §5.3 default cookie-path from the request URI.
+  defaultCookiePath(aUri) {
+    let uriPath = "";
+    try {
+      uriPath = aUri.pathQueryRef || "";
+    } catch (e) {
+      return "/";
+    }
+    const q = uriPath.indexOf("?");
+    if (q >= 0) {
+      uriPath = uriPath.slice(0, q);
+    }
+    if (!uriPath.startsWith("/")) {
+      return "/";
+    }
+    const last = uriPath.lastIndexOf("/");
+    if (last <= 0) {
+      return "/";
+    }
+    return uriPath.slice(0, last);
+  },
+
   // Sinytra: store a Set-Cookie-shaped string. nsICookieService's own
   // Set-Cookie parser (setCookieStringFromHttp) requires a channel, which a
   // programmatic set does not have, so parse the common attributes here and
@@ -321,13 +384,13 @@ export const GeckoViewStorageController = {
   // whether the cookie was accepted. Unknown attributes are ignored, as in
   // Chromium.
   setCookie(aUriSpec, aCookieString) {
-    // Mirror Chromium: setting fails while cookies are globally rejected.
-    if (
-      Services.cookies.getCookieBehavior(false) ===
-      Ci.nsICookieService.BEHAVIOR_REJECT
-    ) {
-      return false;
-    }
+    // No cookieBehavior gate: this is the programmatic CookieManager.set
+    // path (nsICookieManager.add backdoor), and Chromium lets explicit API
+    // writes through regardless of the accept flag — the flag only governs
+    // network (page) cookies, which the engine enforces itself. Gating
+    // here broke every programmatic set made while acceptCookie=false
+    // (CTS CookieManagerTest.setUp leaves it false; testSetCookie and
+    // friends expect the write to land).
     let uri;
     try {
       uri = Services.io.newURI(aUriSpec);
@@ -347,7 +410,12 @@ export const GeckoViewStorageController = {
     const name = pieces[0].slice(0, eq).trim();
     const value = pieces[0].slice(eq + 1).trim();
     let cookieHost = host;
-    let path = "/";
+    // RFC 6265 §5.3 default-path (Chromium parity): no Path attribute
+    // means the uri-path up to (not including) the right-most "/", or "/"
+    // when there is none. A hardcoded "/" creates a second key next to
+    // server/JS-set cookies and duplicates same-name cookies instead of
+    // replacing them (CTS CookieManagerTest.testAcceptCookie).
+    let path = this.defaultCookiePath(uri);
     let isSecure = uri.schemeIs("https");
     let isHttpOnly = false;
     let isSession = true;
@@ -405,6 +473,13 @@ export const GeckoViewStorageController = {
         }
       }
     }
+    // RFC 6265bis / Chromium: SameSite=None requires Secure — without it
+    // the cookie is rejected outright (CTS
+    // CookieManagerTest.testSameSiteNoneRequiresSecure). The add() backdoor
+    // does not enforce this itself, so check before storing.
+    if (sameSite === Ci.nsICookie.SAMESITE_NONE && !isSecure) {
+      return false;
+    }
     if (cookieHost !== host) {
       // A Domain attribute may only widen to a domain that matches the URI
       // host (Chromium rejects others), and add() signals a domain cookie
@@ -433,10 +508,10 @@ export const GeckoViewStorageController = {
           ? Ci.nsICookie.SCHEME_HTTPS
           : Ci.nsICookie.SCHEME_HTTP
       );
-      return validation.result === Ci.nsICookieValidation.eOK;
+      return validation != null &&
+        validation.result === Ci.nsICookieValidation.eOK;
     } catch (e) {
       // e.g. single-label domain cookies, which add() refuses.
-      warn`setCookie failed ${e}`;
       return false;
     }
   },
