+
+  // Sinytra patch 0009 (2026-09-27): the child-process services ship in the
+  // webview provider package, not the host app's. When GeckoView classes are
+  // loaded by the framework from a provider APK (System-WebView provider),
+  // ComponentName/Intent/package-info lookups against the host package find
+  // nothing (NameNotFoundException -> child spawn fails -> native SEGV).
+  // The provider package is resolved once: derive the APK carrying GeckoView
+  // classes from the mozglue library path (mirrors GeckoLoader.getLibraryPath),
+  // then name the installed package whose sourceDir matches. Regular
+  // embedders hit the fast path (classloader APK == context APK) and keep
+  // the historical behavior exactly.
+  private static String sComponentPackage;
+
+  /* package */ static String getComponentPackage(@NonNull final Context context) {
+    if (sComponentPackage != null) {
+      return sComponentPackage;
+    }
+    String resolved = context.getPackageName();
+    try {
+      final String mozglue =
+          ((dalvik.system.BaseDexClassLoader) ServiceUtils.class.getClassLoader())
+              .findLibrary("mozglue");
+      final String contextApk = context.getPackageResourcePath();
+      final String providerApk;
+      if (mozglue != null && mozglue.lastIndexOf("!/") > 0) {
+        providerApk = mozglue.substring(0, mozglue.lastIndexOf("!/"));
+      } else {
+        providerApk = contextApk;
+      }
+      if (providerApk.equals(contextApk)) {
+        // Fast path: classes and services live in the context APK.
+        resolved = context.getPackageName();
+      } else {
+        final PackageInfo pi = android.webkit.WebView.getCurrentWebViewPackage();
+        if (pi != null
+            && pi.applicationInfo != null
+            && (providerApk.equals(pi.applicationInfo.sourceDir)
+                || providerApk.equals(pi.applicationInfo.publicSourceDir))) {
+          resolved = pi.packageName;
+        }
+      }
+    } catch (final Throwable t) {
+      resolved = context.getPackageName();
+    }
+    sComponentPackage = resolved;
+    return sComponentPackage;
+  }
+
   /** Obtain the list of all services defined for |context|. */
   private static ServiceInfo[] getServiceList(@NonNull final Context context) {
     final PackageInfo packageInfo;
@@ -102,7 +151,7 @@ import androidx.annotation.NonNull;
       packageInfo =
           context
               .getPackageManager()
-              .getPackageInfo(context.getPackageName(), PackageManager.GET_SERVICES);
+              .getPackageInfo(getComponentPackage(context), PackageManager.GET_SERVICES);
     } catch (final PackageManager.NameNotFoundException e) {
       throw new AssertionError("Should not happen: Can't get package info of own package");
     }
